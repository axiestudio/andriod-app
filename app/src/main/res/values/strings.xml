    <string name="setup_title">Set up remote control</string>
    <string name="setup_message">Axie Remote needs two system approvals to inject taps and button presses. Takes about 30 seconds.</string>
    <string name="start_setup">Start setup</string>
    <string name="action_later">Later</string>
    <string name="step1_title">1 · Allow restricted settings</string>
    <string name="step1_body">Side-loaded apps are blocked until you allow it: App info → menu (top right) → Allow restricted settings. Needed on Android 13 and newer only.</string>
    <string name="step2_title">2 · Enable Axie Control</string>
    <string name="step2_body">Accessibility settings → Downloaded apps → Axie Control → turn it on.</string>
