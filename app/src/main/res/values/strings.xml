    <string name="a11y_rationale_title">Enable remote control?</string>
    <string name="a11y_rationale_message">This turns on the Axie Control accessibility service so a remote viewer can tap, swipe and press Back and Home for you. Nothing is enabled until you confirm in system settings.</string>

